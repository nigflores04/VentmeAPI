generator client {
  provider      = "prisma-client-py"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
  previewFeatures = ["multiSchema"] 
}

datasource db {
  provider = "postgresql"
  url      = env("DIRECT_URL")
  directUrl= env("DIRECT_URL")
   schemas  = ["public", "auth"] 
}

model User {
  id               String          @id @default(uuid())
  email            String          @unique
  name             String?         @db.VarChar(100)
  passwordHash     String?
  provider         String          @db.VarChar(20)
  emailVerified    Boolean         @default(false)
  verificationCode String?         @db.VarChar(10)
  codeExpiresAt    DateTime?
  codeAttempts     Int             @default(0)
  createdAt        DateTime        @default(now())
  credits          Int             @default(1)
  generations      GenerationJob[]
  moodboards       Moodboard[]
  payments         Payment[]
  projects         Project[]
  subscriptions    Subscription[]

  @@index([email])
  @@map("users")
  @@schema("public") 
}

model GenerationJob {
  id           String   @id @default(uuid())
  userId       String?
  status       String   @db.VarChar(20)
  reference    String   @db.Text
  prompt       String?  @db.Text
  room_type    String?  @db.VarChar(50)
  style_preset String?  @db.VarChar(50)
  width        Int
  height       Int
  output       String?  @db.Text
  error        String?  @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  projectId    String?
  project      Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([projectId])
  @@index([status])
  @@index([createdAt])
  @@map("generation_jobs")
  @@schema("public") 
}

model Payment {
  id                String        @id @default(uuid())
  userId            String
  plan              String?       @db.VarChar(50)
  amount            Int
  credits           Int
  status            String        @db.VarChar(20)
  createdAt         DateTime      @default(now())
  completedAt       DateTime?
  description       String        @db.Text
  isSubscription    Boolean       @default(false)
  payment_reference String        @unique @db.VarChar(100)
  subscriptionId    String?
  subscription      Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([payment_reference])
  @@index([status])
  @@map("payments")
  @@schema("public") 
}

model Subscription {
  id              String    @id @default(uuid())
  userId          String
  plan            String    @db.VarChar(50)
  planCode        String    @db.VarChar(50)
  status          String    @db.VarChar(20)
  nextPaymentDate DateTime?
  lastPaymentDate DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  payments        Payment[]
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@map("subscriptions")
  @@schema("public") 
}

model Project {
  id             String          @id @default(uuid())
  userId         String
  name           String          @db.VarChar(200)
  description    String?         @db.Text
  isActive       Boolean         @default(true)
  referenceImage String?         @db.Text
  prompt         String?         @db.Text
  room_type      String?         @db.VarChar(50)
  style_preset   String?         @db.VarChar(50)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  generations    GenerationJob[]
  moodboards     Moodboard[]
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isActive])
  @@map("projects")
  @@schema("public") 
}

model Moodboard {
  id             String   @id @default(uuid())
  projectId      String
  userId         String?
  referenceImage String   @db.Text
  prompt         String?  @db.Text
  style          String?  @db.VarChar(50)
  colorPalette   String?  @db.VarChar(100)
  status         String   @db.VarChar(20)
  items          String   @db.Text
  output         String?  @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user           User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([userId])
  @@index([status])
  @@map("moodboards")
  @@schema("public") 
}

model EmailSubscriber {
  id        String   @id @default(uuid())
  email     String   @unique @db.VarChar(255)
  name      String?  @db.VarChar(100)
  source    String?  @db.VarChar(50)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([email])
  @@index([isActive])
  @@map("email_subscribers")
  @@schema("public") 
}
