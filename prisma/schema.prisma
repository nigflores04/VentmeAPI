generator client {
  provider = "prisma-client-py"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                String   @id @default(uuid())
  email             String   @unique
  name              String?
  passwordHash      String?
  provider          String   // "password" | "google"
  emailVerified     Boolean  @default(false)
  verificationCode  String?
  codeExpiresAt     DateTime?
  codeAttempts      Int      @default(0)
  createdAt         DateTime @default(now())
  generations       GenerationJob[]
  payments          Payment[]
  subscriptions     Subscription[]
  credits           Int      @default(1)
  projects          Project[]
  moodboards        Moodboard[]
}

model GenerationJob {
  id             String   @id @default(uuid())
  userId         String?
  user           User?    @relation(fields: [userId], references: [id])
  projectId      String?
  project        Project? @relation(fields: [projectId], references: [id])
  status         String   // queued | running | done | failed
  reference      String
  prompt         String?
  room_type      String?
  style_preset   String?
  width          Int
  height         Int
  output         String?
  error          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Payment {
  id                String   @id @default(uuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id])
  payment_reference String   @unique
  plan              String?   // subscription plan
  amount            Int      // in kobo
  credits           Int
  status            String   // pending | processing | successful | failed | cancelled
  description       String
  createdAt         DateTime @default(now())
  completedAt       DateTime?
  isSubscription    Boolean  @default(false)
  subscription      Subscription? @relation(fields: [subscriptionId], references: [id])
  subscriptionId    String?
}

model Subscription {
  id                String   @id @default(uuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id])
  plan              String   // subscription plan name
  planCode          String   // Paystack plan code
  status            String   // active | cancelled | expired
  nextPaymentDate   DateTime?
  lastPaymentDate   DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  payments          Payment[]
}

model Project {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String?
  isActive    Boolean  @default(true)
  
  // Generation parameters that get updated as user makes changes
  referenceImage String?  // Current reference image URL
  prompt         String?  // Current prompt
  room_type       String?  // Current room type
  style_preset    String?  // Current style preset
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  generations GenerationJob[]
  moodboards  Moodboard[]
}

model Moodboard {
  id             String   @id @default(uuid())
  projectId      String
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId         String?
  user           User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  referenceImage String
  prompt         String?
  style          String?
  colorPalette   String?
  status         String   // "generating", "completed", "failed"
  items          String   // JSON string of moodboard items
  output         String?  // S3 URL of the generated moodboard image
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model EmailSubscriber {
  id          String   @id @default(uuid())
  email       String   @unique
  name        String?
  source      String?  // "website" | "api" | "landing_page"
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
}
