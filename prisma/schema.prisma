generator client {
  provider = "prisma-client-py"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String   @id @default(uuid())
  email             String   @unique
  name              String?
  passwordHash      String?
  provider          String   // "password" | "google"
  emailVerified     Boolean  @default(false)
  verificationCode  String?
  codeExpiresAt     DateTime?
  codeAttempts      Int      @default(0)
  createdAt         DateTime @default(now())
  generations       GenerationJob[]
  payments          Payment[]
  subscriptions     Subscription[]
  credits           Int      @default(1)
}

model GenerationJob {
  id             String   @id @default(uuid())
  userId         String?
  user           User?    @relation(fields: [userId], references: [id])
  status         String   // queued | running | done | failed
  reference      String
  prompt         String?
  room_type      String?
  style_preset   String?
  width          Int
  height         Int
  output         String?
  error          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Payment {
  id                String   @id @default(uuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id])
  payment_reference String   @unique
  plan              String?   // subscription plan
  amount            Int      // in kobo
  credits           Int
  status            String   // pending | processing | successful | failed | cancelled
  description       String
  createdAt         DateTime @default(now())
  completedAt       DateTime?
  isSubscription    Boolean  @default(false)
  subscription      Subscription? @relation(fields: [subscriptionId], references: [id])
  subscriptionId    String?
}

model Subscription {
  id                String   @id @default(uuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id])
  plan              String   // subscription plan name
  planCode          String   // Paystack plan code
  status            String   // active | cancelled | expired
  nextPaymentDate   DateTime?
  lastPaymentDate   DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  payments          Payment[]
}
